# .env.example — copy to .env for local dev, set these in Railway for production
# NEVER commit .env to git

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API → Project API keys
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here   # secret — never expose in frontend

# Set to "false" to disable Supabase persistence during local dev (optional)
# SUPABASE_ENABLED=false

# ── API ───────────────────────────────────────────────────────────────────────
# Override poll interval (minutes) — default is 5
# POLL_INTERVAL_MINUTES=5

# ── Serving metadata for feedback loop ────────────────────────────────────────
SERVING_MODEL_VERSION=benchmark_v2__compact22__bestparams_v2
SERVING_BENCHMARK_ID=benchmark_v2
SERVING_FEATURE_SET_VERSION=candidate_feature_set_v1
SERVING_DATASET_VERSION=dataset_v5_dedup
SERVING_MLFLOW_RUN_ID=
